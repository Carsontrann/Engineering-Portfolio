<!-- GRAPH SCRIPT -->

<script>

  const svg = document.getElementById("rpmChart");
  const NS = "http://www.w3.org/2000/svg";

  const data = [
    { dt: -21.5, rpm: -70 },
    { dt: 18.3, rpm: 58 },
    { dt: 39.1, rpm: 92 },
    { dt: 40.3, rpm: 104 },
    { dt: 51.5, rpm: 142 },
    { dt: 63.2, rpm: 214 },
    { dt: 73.4, rpm: 246 }
  ];

  const width = 760;
  const height = 420;

  const margin = {
    left: 75,
    right: 30,
    top: 30,
    bottom: 65
  };

  const xMin = -25;
  const xMax = 80;

  const yMin = -100;
  const yMax = 270;

  const plotWidth =
    width - margin.left - margin.right;

  const plotHeight =
    height - margin.top - margin.bottom;


  function sx(x) {

    return margin.left +
      ((x - xMin) / (xMax - xMin)) *
      plotWidth;

  }


  function sy(y) {

    return margin.top +
      (1 - ((y - yMin) / (yMax - yMin))) *
      plotHeight;

  }


  function add(type, attributes, text) {

    const element =
      document.createElementNS(NS, type);

    for (const key in attributes) {
      element.setAttribute(key, attributes[key]);
    }

    if (text !== undefined) {
      element.textContent = text;
    }

    svg.appendChild(element);

    return element;

  }


  /* BACKGROUND */

  add("rect", {
    x: 0,
    y: 0,
    width: width,
    height: height,
    fill: "#ffffff"
  });


  /* GRID */

  const xTicks = [-20, 0, 20, 40, 60, 80];
  const yTicks = [-100, 0, 100, 200];


  xTicks.forEach(value => {

    add("line", {
      x1: sx(value),
      x2: sx(value),
      y1: margin.top,
      y2: height - margin.bottom,
      stroke: "#e2e8f0",
      "stroke-width": "1"
    });

    add("text", {
      x: sx(value),
      y: height - margin.bottom + 24,
      "text-anchor": "middle",
      fill: "#64748b",
      "font-size": "13"
    }, value);

  });


  yTicks.forEach(value => {

    add("line", {
      x1: margin.left,
      x2: width - margin.right,
      y1: sy(value),
      y2: sy(value),
      stroke: "#e2e8f0",
      "stroke-width": "1"
    });

    add("text", {
      x: margin.left - 12,
      y: sy(value) + 4,
      "text-anchor": "end",
      fill: "#64748b",
      "font-size": "13"
    }, value);

  });


  /* AXES */

  add("line", {
    x1: margin.left,
    y1: height - margin.bottom,
    x2: width - margin.right,
    y2: height - margin.bottom,
    stroke: "#334155",
    "stroke-width": "2"
  });


  add("line", {
    x1: margin.left,
    y1: margin.top,
    x2: margin.left,
    y2: height - margin.bottom,
    stroke: "#334155",
    "stroke-width": "2"
  });


  /* ZERO LINES */

  add("line", {
    x1: sx(0),
    x2: sx(0),
    y1: margin.top,
    y2: height - margin.bottom,
    stroke: "#94a3b8",
    "stroke-width": "1.5"
  });


  add("line", {
    x1: margin.left,
    x2: width - margin.right,
    y1: sy(0),
    y2: sy(0),
    stroke: "#94a3b8",
    "stroke-width": "1.5"
  });


  /* REGRESSION LINE */

  const lineX1 = -25;
  const lineX2 = 80;

  const lineY1 =
    3.26 * lineX1 - 10.8;

  const lineY2 =
    3.26 * lineX2 - 10.8;


  add("line", {
    x1: sx(lineX1),
    y1: sy(lineY1),
    x2: sx(lineX2),
    y2: sy(lineY2),
    stroke: "#60a5fa",
    "stroke-width": "3"
  });


  /* DATA POINTS */

  data.forEach(point => {

    const circle = add("circle", {
      cx: sx(point.dt),
      cy: sy(point.rpm),
      r: 6,
      fill: "#2563eb",
      stroke: "#ffffff",
      "stroke-width": "2"
    });

    const title =
      document.createElementNS(NS, "title");

    title.textContent =
      "ΔT: " +
      point.dt +
      "°C, RPM: " +
      point.rpm;

    circle.appendChild(title);

  });


  /* AXIS LABELS */

  add("text", {
    x: margin.left + plotWidth / 2,
    y: height - 15,
    "text-anchor": "middle",
    fill: "#334155",
    "font-size": "15",
    "font-weight": "bold"
  }, "Temperature Difference, ΔT (°C)");


  const yLabel = add("text", {
    x: 20,
    y: margin.top + plotHeight / 2,
    "text-anchor": "middle",
    fill: "#334155",
    "font-size": "15",
    "font-weight": "bold",
    transform:
      "rotate(-90 20 " +
      (margin.top + plotHeight / 2) +
      ")"
  }, "Flywheel Speed (RPM)");


  /* LEGEND */

  add("circle", {
    cx: 525,
    cy: 28,
    r: 5,
    fill: "#2563eb"
  });

  add("text", {
    x: 538,
    y: 33,
    fill: "#475569",
    "font-size": "12"
  }, "Measured Data");


  add("line", {
    x1: 635,
    x2: 665,
    y1: 28,
    y2: 28,
    stroke: "#60a5fa",
    "stroke-width": "3"
  });

  add("text", {
    x: 672,
    y: 33,
    fill: "#475569",
    "font-size": "12"
  }, "Linear Fit");

</script>


